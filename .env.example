OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Optional: inherit OPENAI_MODEL when blank.
OPENAI_VISION_MODEL=
OPENAI_EVAL_MODEL=
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_WEB_ENABLED=false
EMBEDDING_PROVIDER=minilm
LOCAL_EMBEDDING_CACHE=data/models/minilm
# local_hash is available for credential-free offline evaluation, not semantic search.
# OpenAI is used for final answer generation, not embeddings.

QDRANT_COLLECTION=finsight_chunks
QDRANT_PATH=data/index/qdrant
